{
  "compilerOptions": {
    "target": "ESNext",                   // 编译目标ES版本
    "module": "ESNext",                   // 模块系统
    "lib": ["DOM", "DOM.Iterable", "ESNext"], // 包含的库
    "jsx": "react-jsx",                   // JSX处理方式 (React 17+)
    "strict": true,                       // 启用所有严格类型检查
    "esModuleInterop": true,              // 允许CommonJS/ES模块互操作
    "skipLibCheck": true,                 // 跳过声明文件的类型检查
    "moduleResolution": "node",           // 模块解析策略
    "baseUrl": "./",                      // 解析非相对模块的基目录
    "paths": {                            // 路径映射
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowJs": true,                      // 允许编译JavaScript文件
    "resolveJsonModule": true             // 允许导入JSON文件
  },
  "include": ["src/**/*"],                // 包含的文件
  "exclude": ["node_modules", "dist"]     // 排除的文件
}