{
  "scripts": {
    "start": "webpack-dev-server --mode development",
    "build": "yarn dll:build && cross-env NODE_ENV=production webpack --mode production",
    "analyze": "cross-env NODE_ENV=production webpack --mode production && open dist/bundle-report.html",
    "analyze:stats": "webpack-bundle-analyzer dist/stats.json",
    "dll:start": "cross-env NODE_ENV=development webpack --config webpack.dll.config.js",
    "dll:build": "cross-env NODE_ENV=production webpack --config webpack.dll.config.js"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/plugin-transform-runtime": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.27.6",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "add-asset-html-webpack-plugin": "^6.0.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "clean-webpack-plugin": "^4.0.0",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "html-webpack-plugin": "^5.6.3",
    "image-webpack-loader": "^8.1.0",
    "mini-css-extract-plugin": "^2.9.2",
    "postcss-loader": "^8.1.1",
    "sass": "^1.89.1",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "thread-loader": "^4.0.4",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
