{
  "name": "vue3-app",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview",
    "build:test": "run-p build-only-test",
    "build": "run-p build-only",
    "build-only-test": "vite build --mode=test",
    "build-only": "vite build",
    "lint:script": "export NODE_ENV=production && eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:style": "stylelint --fix \"src/**/*.{css,scss,vue}\"",
    "lint": "export NODE_ENV=production && npm run lint:script && npm run lint:style",
    "format": "prettier --write src/",
    "prepare": "husky install",
    "analyze": "vite build --mode analyze"
  },
  "dependencies": {
    "axios": "1.6.8",
    "clipboard": "2.0.8",
    "dayjs": "1.11.13",
    "highcharts": "11.4.6",
    "js-cookie": "3.0.5",
    "lodash": "4.17.21",
    "pinia": "2.1.7",
    "vant": "4.8.11",
    "vue": "3.4.21",
    "vue-router": "4.3.0",
    "vue3-lazy": "^1.0.0-alpha.1",
    "weixin-js-sdk": "1.6.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.2.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.12.11",
    "@types/postcss-import": "^14.0.0",
    "@types/postcss-pxtorem": "^6.0.3",
    "@vant/auto-import-resolver": "^1.2.1",
    "@vitejs/plugin-legacy": "^4.0.2",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "@vue/tsconfig": "^0.1.3",
    "autoprefixer": "^10.4.13",
    "babel-polyfill": "6.26.0",
    "eslint": "^8.34.0",
    "eslint-plugin-vue": "^9.11.0",
    "husky": "^8.0.3",
    "intersection-observer": "0.12.2",
    "lib-flexible": "0.3.2",
    "lint-staged": "^13.2.0",
    "npm-run-all": "^4.1.5",
    "postcss-html": "^1.5.0",
    "postcss-import": "^15.1.0",
    "postcss-pxtorem": "^6.0.0",
    "postcss-scss": "^4.0.6",
    "prettier": "^2.8.4",
    "sass": "^1.74.1",
    "sass-loader": "^14.1.1",
    "stylelint": "^15.3.0",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-recess-order": "^4.0.0",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard-scss": "^7.0.1",
    "stylelint-prettier": "^3.0.0",
    "terser": "^5.16.6",
    "typescript": "~4.7.4",
    "unplugin-auto-import": "^0.18.3",
    "unplugin-vue-components": "^0.27.4",
    "vite": "5.2.0",
    "vite-bundle-analyzer": "^0.15.2",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-stylelint": "^4.3.0",
    "vue-tsc": "2.0.6"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,vue}": [
      "npm run lint:script",
      "git add .",
      "git add -A"
    ],
    "**/*.{scss, vue}": [
      "npm run lint:style",
      "git add .",
      "git add -A"
    ]
  },
  "husky": {
    "pre-commit": "lint-staged"
  }
}
